# Public browser setting: points the Vite app at the read-only local API proxy.
VITE_API_BASE_URL=http://localhost:8787/api

# Server-only settings. Never prefix these with VITE_.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-max

# Optional earnings provider. The provider should return events with a date,
# earningsDate, reportDate, dateTime, startDate or time field.
EARNINGS_CALENDAR_URL=
EARNINGS_API_KEY=
EARNINGS_TICKER_PARAM=ticker
EARNINGS_API_KEY_HEADER=Authorization
EARNINGS_API_KEY_PREFIX=Bearer 

# Public BSC RPC URL; can be replaced with another public, read-only endpoint.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
PROXY_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787